<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleIdentifier</key>
	<string>dev.fremkit.helper</string>
	<key>CFBundleName</key>
	<string>Fremkit Helper</string>
	<key>CFBundleDisplayName</key>
	<string>Fremkit Helper</string>
	<key>CFBundleExecutable</key>
	<string>FremkitHelper</string>
	<key>CFBundleIconFile</key>
	<string>Fremkit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Stamped at build time from server/src/version.ts (scripts/lib/version.sh). -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Shown when the server first asks Terminal or iTerm2 to bring a Claude Code session forward.
	     Translated in native/Resources/{en,fr}.lproj/InfoPlist.strings. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Fremkit brings the window of the Claude Code session you touched to the front.</string>
	<!-- fremkit://admin opens the admin window; see HelperURL in FremkitCore. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.fremkit.helper</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fremkit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
