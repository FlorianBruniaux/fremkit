{
  "name": "server",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/bridge && cp src/bridge/fremkit.js dist/bridge/fremkit.js",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.5",
    "ical.js": "^2.2.1",
    "mqtt": "^5.16.0",
    "systeminformation": "^5.33.10",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "~5.9.0",
    "vitest": "^5.0.1"
  }
}
